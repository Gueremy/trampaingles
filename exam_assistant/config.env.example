# =================================================================
# ARCHIVO DE CONFIGURACIÓN DE EXAM ASSISTANT (PLANTILLA)
# =================================================================
# INSTRUCCIONES PARA TU AMIGO: 
# 1. Cambia el nombre de este archivo de "config.env.example" a "config.env"
# 2. Pega tu API Key de NVIDIA u OpenRouter abajo en OPENROUTER_API_KEY
# 3. Guarda el archivo y ejecuta main.py
# =================================================================

# 1. Tu API KEY (Si usas NVIDIA, pega aquí la que empieza por nvapi-)
OPENROUTER_API_KEY=tu_clave_api_aqui

# 2. Modelo activo de IA (Mistral Medium avanzado)
AI_MODEL=mistral-medium-3.5-128b

# 3. La dirección de la API (Si usas una clave de OpenRouter sk-or-v1..., comenta esta línea con '#')
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# 4. Índice de la pantalla a monitorear (1 = pantalla secundaria, 0 = pantalla principal)
MONITOR_INDEX=1
